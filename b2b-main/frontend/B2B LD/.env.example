# Base URL of the backend API this frontend talks to.
# Dev default (used when unset) is http://127.0.0.1:8000 — see src/lib/api.js.
# For a production build, this MUST be set to the real backend URL, since
# Vite bakes it into the build at build time (not read at runtime):
#   VITE_API_BASE_URL=https://api.yourdomain.com npm run build
VITE_API_BASE_URL=http://127.0.0.1:8000
