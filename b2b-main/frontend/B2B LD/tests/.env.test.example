# Copy this file to tests/.env.test (already gitignored) and fill in real
# values. Nothing in this suite hardcodes credentials — every spec reads
# from tests/fixtures/env.js, which reads from process.env.
#
# Override the frontend URL under test (defaults to the Vite dev server).
# BASE_URL=http://localhost:5173

# Super Admin login (role=admin, Super Admin Portal /superadmin). Required by
# admin-onboard-dealer.spec.js / admin-onboard-retailer.spec.js, which use it
# to create fresh Dealer/Retailer test orgs through the real Customer Onboard
# wizard.
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=

# Partner Portal login (role=partner). Either supply your own, or leave blank
# and run admin-onboard-dealer.spec.js once — it generates a fresh one and
# writes it to tests/.generated-partner.json for you to copy in here.
TEST_PARTNER_EMAIL=
TEST_PARTNER_PASSWORD=

# User Portal login (role=member). Either supply your own, or leave blank and
# run admin-onboard-retailer.spec.js once — it generates a fresh one and
# writes it to tests/.generated-member.json for you to copy in here.
TEST_MEMBER_EMAIL=
TEST_MEMBER_PASSWORD=

# Not currently used by any spec — no test login exists for this role yet.
# TEST_PLATFORM_ADMIN_EMAIL=
# TEST_PLATFORM_ADMIN_PASSWORD=
